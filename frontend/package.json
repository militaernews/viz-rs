{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "1.3.1",
		"@eslint/js": "9.31.0",
		"@iconify-json/bi": "1.2.4",
		"@iconify-json/flat-color-icons": "1.2.1",
		"@iconify-json/fluent": "1.2.27",
		"@iconify-json/fluent-color": "1.2.15",
		"@iconify-json/fluent-emoji": "1.2.3",
		"@iconify-json/logos": "1.2.5",
		"@iconify-json/material-symbols": "1.2.30",
		"@iconify-json/mdi": "1.2.3",
		"@sveltejs/kit": "2.26.0",
		"@sveltejs/vite-plugin-svelte": "6.1.0",
		"@tailwindcss/vite": "4.1.11",
		"@vite-pwa/sveltekit": "1.0.0",
		"daisyui": "5.0.46",
		"eslint": "9.31.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.11.0",
		"globals": "16.3.0",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "3.4.0",
		"prettier-plugin-tailwindcss": "0.6.14",
		"svelte": "5.36.16",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "4.3.0",
		"tailwindcss": "4.1.11",
		"typescript": "5.8.3",
		"typescript-eslint": "8.38.0",
		"unplugin-icons": "22.1.0",
		"vite": "7.0.6"
	},
	"dependencies": {
		"@iconify/svelte": "5.0.0",
		"sveltekit-superforms": "2.27.1",
		"valibot": "1.1.0"
	}
}
