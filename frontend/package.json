{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "1.2.9",
		"@eslint/js": "9.26.0",
		"@iconify-json/bi": "1.2.3",
		"@iconify-json/flat-color-icons": "1.2.1",
		"@iconify-json/fluent": "1.2.20",
		"@iconify-json/fluent-color": "1.2.12",
		"@iconify-json/fluent-emoji": "1.2.3",
		"@iconify-json/logos": "1.2.4",
		"@iconify-json/material-symbols": "1.2.20",
		"@iconify-json/mdi": "1.2.3",
		"@sveltejs/adapter-static": "3.0.8",
		"@sveltejs/kit": "2.20.8",
		"@sveltejs/vite-plugin-svelte": "5.0.3",
		"@tailwindcss/vite": "4.1.6",
		"@vite-pwa/sveltekit": "1.0.0",
		"daisyui": "5.0.35",
		"eslint": "9.26.0",
		"eslint-config-prettier": "10.1.5",
		"eslint-plugin-svelte": "3.5.1",
		"globals": "16.1.0",
		"prettier": "3.5.3",
		"prettier-plugin-svelte": "3.3.3",
		"prettier-plugin-tailwindcss": "0.6.11",
		"svelte": "5.28.2",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "4.1.7",
		"tailwindcss": "4.1.6",
		"typescript": "5.8.3",
		"typescript-eslint": "8.32.0",
		"unplugin-icons": "22.1.0",
		"vite": "6.3.5"
	},
	"dependencies": {
		"@iconify/svelte": "5.0.0",
		"sveltekit-superforms": "2.25.0",
		"valibot": "1.1.0"
	}
}
