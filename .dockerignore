# Ignore Git directory
.git/
.gitignore

# Ignore editor files
/frontend/.vscode/
/service/.idea/
*.swp
*.swo

# Ignore environment files
.env
.env.*

# Ignore documentation
docs/
*.md

# Ignore test data
test_data/

# Ignore temporary files
tmp/
temp/

# Ignore node modules if using any JS tooling
/frontend/node_modules/
/frontend/build/
/frontend/.svelte-kit
/service/target

# Ignore large datasets
data/
datasets/
*.csv
*.json
*.sqlite

# Keep necessary configuration files
!config/*.json
!config/*.yaml

