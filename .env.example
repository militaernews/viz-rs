# Copy to .env for local development. In production these come from the host's secret
# manager (Podman secrets / Quadlet Environment=), never from a committed file.
# Defaults below match compose.yaml.

# Telegram (MTProto, from https://my.telegram.org) - ingest only
TG_API_ID=
TG_API_HASH=
# Only needed for `ingest --login`
TG_PHONE=
TG_SESSION_PATH=./data/ingest.session
# Optional: poll this file for the login code / 2FA password when there is no TTY
# TG_CODE_FILE=./data/login-code

# Postgres (ingest and api each open their own pool)
DATABASE_URL=postgres://user:pass@localhost:5432/tgsearch
API_DB_MAX_CONNECTIONS=10

# Qdrant (gRPC port)
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=media

# Object storage (S3-compatible: RustFS locally, R2/S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=thumbs
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
# Public URL prefix for thumb keys (CDN or the bucket's public endpoint)
S3_PUBLIC_BASE_URL=http://localhost:9000/thumbs
# Or keep the bucket private and let the api serve /thumbs/{key} (needs the S3_* values above):
# API_SERVE_THUMBS=true
# S3_PUBLIC_BASE_URL=http://localhost:8080/thumbs

# API server
API_BIND_ADDR=0.0.0.0:8080
# Exact origin of the viz-sv frontend
API_ALLOWED_ORIGIN=http://localhost:5173
# 25 MiB
API_MAX_UPLOAD_BYTES=26214400
# Shared secret viz-sv's server sends as `x-api-key`. Generate with `openssl rand -hex 32`.
BACKEND_API_KEY=

# Models (ONNX exports, see README)
CLIP_VISION_MODEL_PATH=./models/clip-vision.onnx
CLIP_TEXT_MODEL_PATH=./models/clip-text.onnx
CLIP_TOKENIZER_PATH=./models/clip-tokenizer.json

# ffmpeg
FFMPEG_BIN=ffmpeg
FRAME_EXTRACT_TIMEOUT_SECS=60

# Ingest tuning (optional)
# CHANNELS_FILE=./channels.toml
# INGEST_WORKERS=4
# INGEST_MAX_MEDIA_BYTES=209715200
# Leave TESSERACT_BIN unset to disable OCR
# TESSERACT_BIN=tesseract
# TESSERACT_LANGS=eng+rus+ukr

RUST_LOG=info
