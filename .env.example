DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared secret that viz-sv's SvelteKit server must send as the `x-api-key` header
# on every request. Generate one with `openssl rand -hex 32`. Never expose this to
# a browser - only the SvelteKit backend should hold it.
BACKEND_API_KEY=

# Optional, comma-separated. Only needed for hitting this API directly from a
# browser during local development; the SvelteKit backend calls it server-to-server
# and is not subject to CORS. Defaults to http://localhost:3011,http://localhost:5173
# when unset.
CORS_ALLOWED_ORIGINS=
